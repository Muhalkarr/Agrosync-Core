{
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Production Server (after build)",
            "program": "${workspaceFolder}/server.js",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "npm: build",
            "env": {
                "NODE_ENV": "production"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        }
    ]
}